{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "gen:theme": "tsx scripts/generate-fleet-ui-theme.ts",
    "gen:components": "tsx scripts/generate-components-index.ts",
    "gen:component-docs": "tsx scripts/generate-component-content.ts",
    "gen:playground-samples": "tsx scripts/generate-playground-sample-code.ts",
    "gen:llms": "tsx scripts/generate-llms-txt.ts",
    "check:i18n": "tsx scripts/check-i18n-sync.ts --mode=warn",
    "check:i18n:strict": "tsx scripts/check-i18n-sync.ts --mode=strict",
    "dev": "pnpm gen:theme && pnpm gen:components && pnpm gen:playground-samples && pnpm gen:component-docs && pnpm gen:llms && pnpm check:i18n && next dev --webpack",
    "build": "pnpm gen:theme && pnpm gen:components && pnpm gen:playground-samples && pnpm gen:component-docs && pnpm gen:llms && pnpm check:i18n && next build --webpack",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.1.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@rehype-pretty/transformers": "^0.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.26.1",
    "lucide-react": "^0.562.0",
    "next": "16.1.0",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-resizable-panels": "^4.0.11",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.20.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
